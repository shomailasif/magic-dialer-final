// AutoDial AI - Multi-tenant SaaS schema
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  BUSINESS_ADMIN
}

enum SubscriptionPlan {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum LeadStatus {
  PENDING
  CALLED
  INTERESTED
  CONVERTED
  NOT_INTERESTED
  FAILED
}

enum CallOutcome {
  CONNECTED
  NO_ANSWER
  BUSY
  UNREACHABLE
  FAILED
}

enum DialerProvider {
  TWILIO
  RINGCENTRAL
  VONAGE
}

enum AgentTone {
  CONSULTATIVE
  DIRECT
  FRIENDLY
}

enum CampaignStatus {
  RUNNING
  PAUSED
  COMPLETED
}

enum ImportStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
}

model User {
  id            String           @id @default(cuid())
  email         String           @unique
  passwordHash  String
  name          String?
  role          UserRole         @default(BUSINESS_ADMIN)
  companyName   String?
  createdByAdminId String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  subscription  Subscription?
  agentConfig   AIAgentConfig?
  dialerConfig  DialerConfig?
  leads         Lead[]
  calls         Call[]
  campaigns     CallCampaign[]
  imports       LeadImport[]
  aiGenerations AILeadGeneration[]
  notifications Notification[]
  passwordResets PasswordReset[]
  sessions      Session[]
  engineDevices EngineDevice[]
  engineEnrollmentTickets EngineEnrollmentTicket[]
  productKnowledge ProductKnowledge[]
  salesStrategies SalesStrategy[]
  salesExperiments SalesExperiment[]
  callAttributions CallAttribution[]
  strategyLearningEvents StrategyLearningEvent[]
  phoneSuppressions PhoneSuppression[]
  activeEngineMachineId String?
  engineLeaseUntil DateTime?

  @@index([role])
}

model Subscription {
  id           String             @id @default(cuid())
  userId       String             @unique
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan         SubscriptionPlan   @default(FREE)
  status       SubscriptionStatus @default(PENDING)
  startedAt    DateTime?
  nextBilling  DateTime?
  notes        String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  history SubscriptionHistory[]

  @@index([status])
}

model SubscriptionHistory {
  id        String             @id @default(cuid())
  subId     String
  sub       Subscription       @relation(fields: [subId], references: [id], onDelete: Cascade)
  plan      SubscriptionPlan
  status    SubscriptionStatus
  changedAt DateTime           @default(now())
}

model AIAgentConfig {
  id                String    @id @default(cuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  productName       String?
  productDesc       String?
  valueProps        String?
  pricing           String?
  targetAudience    String?

  pitch             String?
  tone              AgentTone @default(CONSULTATIVE)
  defaultLanguage   String    @default("en")

  objectionHandling String?
  followUpAttempts  Int       @default(2)
  followUpIntervalHours Int   @default(24)

  learningNotes     String?
  updatedAt         DateTime  @updatedAt
  createdAt         DateTime  @default(now())
}

model DialerConfig {
  id             String        @id @default(cuid())
  userId         String        @unique
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider       DialerProvider @default(TWILIO)
  apiKey         String?
  accountSid     String?
  outboundNumber String?
  sipUsername    String?
  sipPassword    String?
  sipAuthId      String?
  sipDomain      String?
  sipProxy       String?
  sipPort        String?
  validated      Boolean       @default(false)
  updatedAt      DateTime      @updatedAt
  createdAt      DateTime      @default(now())
}

model Lead {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  name         String?
  phone        String?
  email        String?
  company      String?
  extraData    String?    // JSON string of additional uploaded/generated fields

  status       LeadStatus @default(PENDING)
  lastCallAt   DateTime?
  disposition  String?
  doNotCall     Boolean    @default(false)
  doNotCallAt   DateTime?
  doNotCallReason String?
  consentStatus String     @default("UNKNOWN")
  consentSource String?
  consentUpdatedAt DateTime?

  followUpDueAt DateTime?
  followUpAttemptsMade Int @default(0)

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  calls        Call[]

  @@index([userId, status])
  @@index([userId, doNotCall])
  @@index([userId])
}

model CallCampaign {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  status      CampaignStatus @default(RUNNING)
  startedAt   DateTime       @default(now())
  endedAt     DateTime?
  callsMade   Int            @default(0)

  calls       Call[]
  strategyId  String?
  strategy    SalesStrategy? @relation(fields: [strategyId], references: [id], onDelete: SetNull)
  experimentId String?
  experiment  SalesExperiment? @relation(fields: [experimentId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model Call {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  leadId         String?
  lead           Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  campaignId     String?
  campaign       CallCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  phoneNumber    String?
  timestamp      DateTime     @default(now())
  durationSecs   Int?
  outcome        CallOutcome  @default(CONNECTED)
  disposition    String?
  aiSummary      String?
  transcript     String?
  resultStatus   LeadStatus?  // status the lead moved to as a result of this call
  collectedData  String?
  executionKey   String?      @unique      // JSON of data collected (seats, email, etc.)

  createdAt      DateTime     @default(now())
  attribution    CallAttribution?

  @@index([userId, timestamp])
  @@index([leadId])
}

model LeadImport {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName  String
  status    ImportStatus @default(PROCESSING)
  totalRows Int          @default(0)
  imported  Int          @default(0)
  failed    Int          @default(0)
  errorsJson String?     // JSON array of {row, reason}
  createdAt DateTime     @default(now())

  @@index([userId])
}

model AILeadGeneration {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  criteria    String   // JSON of industry/geography/size criteria
  status      String   @default("PENDING")
  found       Int      @default(0)
  message     String?
  createdAt   DateTime @default(now())
  completedAt DateTime?

  @@index([userId])
}

model PasswordReset {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  consumed  Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
}

model Session {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceFingerprint String
  ipAddress         String?
  userAgent         String?
  createdAt         DateTime @default(now())
  lastActiveAt      DateTime @default(now())
  expiresAt         DateTime

  @@index([userId])
  @@index([deviceFingerprint])
}

model Notification {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      String             @default("LEAD_INTEREST")
  toEmail   String
  subject   String
  body      String
  leadName  String?
  phone     String?
  leadEmail String?
  seats     Int?
  otherData String?
  status    NotificationStatus @default(QUEUED)
  attempts  Int                @default(0)
  lastError String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([status])
  @@index([userId])
}

model PlatformSetting {
  id        String   @id @default("platform")
  smtpHost  String?
  smtpPort  String?
  smtpSecure String?
  smtpUser  String?
  smtpPass  String?
  smtpFrom  String?
  rcSipUsername String?
  rcSipPassword String?
  rcSipAuthId String?
  rcSipDomain String?
  rcSipProxy String?
  rcSipPort String?
  rcCallerId String?
  rcJwt     String?
  rcClientId String?
  rcClientSecret String?
  onboardingEmail String?
  recoveryPhrase   String?
  notes     String?
  updatedAt DateTime @updatedAt
}


model PhoneSuppression {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  normalizedPhone String
  reason String
  source String
  createdAt DateTime @default(now())
  @@unique([userId, normalizedPhone])
  @@index([userId, createdAt])
}

model EngineDevice {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  machineId   String
  tokenHash   String   @unique
  revokedAt   DateTime?
  lastSeenAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  leaseUntil  DateTime?

  @@unique([userId, machineId])
  @@index([userId])
}

model EngineEnrollmentTicket {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}


model AIQuotaBucket {
 id String @id @default(cuid())
 scopeKey String
 windowStart DateTime
 requestCount Int @default(0)
 units Int @default(0)
 updatedAt DateTime @updatedAt
 @@unique([scopeKey, windowStart])
 @@index([windowStart])
}


model ProductKnowledge {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  version   Int
  productName String
  factsJson String
  source    String   @default("customer-config")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  @@unique([userId, version])
  @@index([userId, active])
}

model SalesStrategy {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  version   Int
  name      String
  objective String
  strategyJson String
  knowledgeVersion Int
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  campaigns CallCampaign[]
  experiments SalesExperiment[]
  attributions CallAttribution[]
  learningEvents StrategyLearningEvent[]
  @@unique([userId, version])
  @@index([userId, active])
}

model SalesExperiment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  strategyId String
  strategy  SalesStrategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  name      String
  variantJson String
  status    String   @default("ACTIVE")
  startedAt DateTime @default(now())
  endedAt   DateTime?
  campaigns CallCampaign[]
  attributions CallAttribution[]
  @@index([userId, status])
  @@index([strategyId])
}

model CallAttribution {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  callId      String   @unique
  call        Call     @relation(fields: [callId], references: [id], onDelete: Cascade)
  strategyId  String
  strategy    SalesStrategy @relation(fields: [strategyId], references: [id], onDelete: Restrict)
  experimentId String?
  experiment  SalesExperiment? @relation(fields: [experimentId], references: [id], onDelete: SetNull)
  outcome     String
  score       Float?
  evidenceJson String?
  createdAt   DateTime @default(now())
  @@index([userId, createdAt])
  @@index([strategyId])
  @@index([experimentId])
}


model StrategyLearningEvent {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  strategyId  String
  strategy    SalesStrategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  outcome     String
  reward      Float
  sampleSize  Int
  action      String   @default("OBSERVE")
  evidenceJson String?
  sourceCallId String? @unique
  createdAt   DateTime @default(now())
  @@index([userId, createdAt])
  @@index([strategyId, createdAt])
}
