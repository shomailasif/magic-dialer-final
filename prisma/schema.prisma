// AutoDial AI - Multi-tenant SaaS schema
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  BUSINESS_ADMIN
}

enum SubscriptionPlan {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum LeadStatus {
  PENDING
  CALLED
  INTERESTED
  CONVERTED
  NOT_INTERESTED
  FAILED
}

enum CallOutcome {
  CONNECTED
  NO_ANSWER
  BUSY
  UNREACHABLE
  FAILED
}

enum DialerProvider {
  TWILIO
  RINGCENTRAL
  VONAGE
}

enum AgentTone {
  CONSULTATIVE
  DIRECT
  FRIENDLY
}

enum CampaignStatus {
  RUNNING
  PAUSED
  COMPLETED
}

enum ImportStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
}

model User {
  id            String           @id @default(cuid())
  email         String           @unique
  passwordHash  String
  name          String?
  role          UserRole         @default(BUSINESS_ADMIN)
  companyName   String?
  createdByAdminId String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  subscription  Subscription?
  agentConfig   AIAgentConfig?
  dialerConfig  DialerConfig?
  leads         Lead[]
  calls         Call[]
  campaigns     CallCampaign[]
  imports       LeadImport[]
  aiGenerations AILeadGeneration[]
  notifications Notification[]
  passwordResets PasswordReset[]

  @@index([role])
}

model Subscription {
  id           String             @id @default(cuid())
  userId       String             @unique
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan         SubscriptionPlan   @default(FREE)
  status       SubscriptionStatus @default(PENDING)
  startedAt    DateTime?
  nextBilling  DateTime?
  notes        String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  history SubscriptionHistory[]

  @@index([status])
}

model SubscriptionHistory {
  id        String             @id @default(cuid())
  subId     String
  sub       Subscription       @relation(fields: [subId], references: [id], onDelete: Cascade)
  plan      SubscriptionPlan
  status    SubscriptionStatus
  changedAt DateTime           @default(now())
}

model AIAgentConfig {
  id                String    @id @default(cuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  productName       String?
  productDesc       String?
  valueProps        String?
  pricing           String?
  targetAudience    String?

  pitch             String?
  tone              AgentTone @default(CONSULTATIVE)
  defaultLanguage   String    @default("en")

  objectionHandling String?
  followUpAttempts  Int       @default(2)
  followUpIntervalHours Int   @default(24)

  learningNotes     String?
  updatedAt         DateTime  @updatedAt
  createdAt         DateTime  @default(now())
}

model DialerConfig {
  id             String        @id @default(cuid())
  userId         String        @unique
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider       DialerProvider @default(TWILIO)
  apiKey         String?
  accountSid     String?
  outboundNumber String?
  validated      Boolean       @default(false)
  updatedAt      DateTime      @updatedAt
  createdAt      DateTime      @default(now())
}

model Lead {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  name         String?
  phone        String?
  email        String?
  company      String?
  extraData    String?    // JSON string of additional uploaded/generated fields

  status       LeadStatus @default(PENDING)
  lastCallAt   DateTime?
  disposition  String?

  followUpDueAt DateTime?

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  calls        Call[]

  @@index([userId, status])
  @@index([userId])
}

model CallCampaign {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  status      CampaignStatus @default(RUNNING)
  startedAt   DateTime       @default(now())
  endedAt     DateTime?
  callsMade   Int            @default(0)

  calls       Call[]

  @@index([userId])
}

model Call {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  leadId         String?
  lead           Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  campaignId     String?
  campaign       CallCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  phoneNumber    String?
  timestamp      DateTime     @default(now())
  durationSecs   Int?
  outcome        CallOutcome  @default(CONNECTED)
  disposition    String?
  aiSummary      String?
  transcript     String?
  resultStatus   LeadStatus?  // status the lead moved to as a result of this call
  collectedData  String?      // JSON of data collected (seats, email, etc.)

  createdAt      DateTime     @default(now())

  @@index([userId, timestamp])
  @@index([leadId])
}

model LeadImport {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName  String
  status    ImportStatus @default(PROCESSING)
  totalRows Int          @default(0)
  imported  Int          @default(0)
  failed    Int          @default(0)
  errorsJson String?     // JSON array of {row, reason}
  createdAt DateTime     @default(now())

  @@index([userId])
}

model AILeadGeneration {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  criteria    String   // JSON of industry/geography/size criteria
  status      String   @default("PENDING")
  found       Int      @default(0)
  message     String?
  createdAt   DateTime @default(now())
  completedAt DateTime?

  @@index([userId])
}

model PasswordReset {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  consumed  Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
}

model Notification {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      String             @default("LEAD_INTEREST")
  toEmail   String
  subject   String
  body      String
  leadName  String?
  phone     String?
  leadEmail String?
  seats     Int?
  otherData String?
  status    NotificationStatus @default(QUEUED)
  attempts  Int                @default(0)
  lastError String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([status])
  @@index([userId])
}

model PlatformSetting {
  id        String   @id @default("platform")
  smtpHost  String?
  smtpPort  String?
  smtpSecure String?
  smtpUser  String?
  smtpPass  String?
  smtpFrom  String?
  rcSipUsername String?
  rcSipPassword String?
  rcSipAuthId String?
  rcSipDomain String?
  rcSipProxy String?
  rcSipPort String?
  rcCallerId String?
  rcJwt     String?
  rcClientId String?
  rcClientSecret String?
  onboardingEmail String?
  recoveryPhrase   String?
  notes     String?
  updatedAt DateTime @updatedAt
}
