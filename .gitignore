# stray copies of build outputs that land at the management root - never sources
/src/management/agent.exe
/src/management/MagicDialer.exe

# Audio-sim prospect fixtures: ~40-150KB of SAPI-generated WAV per scripted line.
# The generator is committed (fixtures/make-fixtures.ps1) and the harness
# synthesizes any missing clip on demand, so the binaries are not sources.
src/management/build/fixtures/*.wav

# Licence signing material. The key that signs licences and your private
# ledger of which customer holds which licence must never leave this PC.
# Only licenses/revoked.json and licenses/suspended.json are published - the
# engines have to read both.
/licenses/license.private.key
/licenses/grants.local.json
